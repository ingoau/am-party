# Public URL guests/admins use (behind your tunnel). Must match the OIDC redirect URI host.
AM_PARTY_PUBLIC_URL=https://party.example.com

# Generic OIDC provider (Authentik, Pocket ID, Keycloak, Authelia, Google, ...)
# Redirect URI to register with the provider: ${AM_PARTY_PUBLIC_URL}/auth/callback
OIDC_ISSUER=https://auth.example.com/application/o/am-party
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Authentik
# OIDC_SCOPES=openid profile email
# Also restrict who may log in to this app at your provider.

# Who becomes admin (recommended; disables "first sign-in becomes admin")
AM_PARTY_ADMIN_EMAILS=you@example.com
# Optional sign-in allowlists (comma-separated)
# AM_PARTY_ALLOWED_EMAILS=friend@example.com,other@example.com
# AM_PARTY_ALLOWED_DOMAINS=example.com

# Set when am-party is ONLY reachable through this proxy: cloudflare | x-forwarded-for
# AM_PARTY_TRUSTED_PROXY=cloudflare
# Guest limits per client IP (party wifi shares one IP, keep these generous)
# AM_PARTY_IP_SEARCHES_PER_MINUTE=120
# AM_PARTY_IP_MAX_PENDING=20
# AM_PARTY_MAX_LISTENERS=100
# Native Sendspin listener for LAN hardware players (off unless set; publish the port)
# AM_PARTY_SENDSPIN_PORT=8927

# Apple Music: either connect from Admin > Settings, or provide files in ./secrets/
# APPLE_MUSIC_DEVELOPER_TOKEN=
# APPLE_MUSIC_USER_TOKEN=

# AM_PARTY_HOST_PORT=8930
# AM_PARTY_LOG_LEVEL=INFO
